# Copy to .env (or export in your shell / CI secrets). Every value is optional.

# Slack or Discord incoming-webhook URL. Alerts are skipped silently when unset.
ALERT_WEBHOOK_URL=

# Database. SQLite by default; any SQLAlchemy URL works, e.g.
# postgresql+psycopg://user:pass@host:5432/listings   (pip install "psycopg[binary]")
# LW_DB_URL=sqlite:///data/listings.db

# Politeness and reliability
# LW_DELAY=1.0          seconds between requests to the same site
# LW_ATTEMPTS=3         tries per request before giving up (exponential backoff)
# LW_TIMEOUT=20         seconds per request / page load
# LW_MAX_PAGES=0        0 = follow pagination to the end

# Data rules
# LW_REMOVED_AFTER=2    mark a listing removed after this many consecutive complete runs without it
# LW_FUZZY_THRESHOLD=92 cross-source near-duplicate similarity, 0-100
# LW_DROP_THRESHOLD=0.5 source is "broken" when it returns this fraction fewer items than its average
# LW_HEALTH_WINDOW=5    how many recent good runs make up that average
